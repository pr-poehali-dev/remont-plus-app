{
  "tests": [
    {
      "name": "Create order - missing plan_type",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create_order",
        "amount": 399,
        "client_name": "Тест",
        "client_email": "test@example.com"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "plan_type и amount обязательны" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check user paid - not found",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "check_user_paid",
        "client_email": "nonexistent@example.com"
      },
      "expectedStatus": 200,
      "expectedBody": { "paid": false },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check status missing",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "check_status",
        "order_number": "EST-00000"
      },
      "expectedStatus": 404,
      "expectedBody": { "error": "Заказ не найден" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unknown"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    }
  ]
}