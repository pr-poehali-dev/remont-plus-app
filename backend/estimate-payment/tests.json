{
  "tests": [
    {
      "name": "Create order - missing plan_type",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create_order",
        "amount": 399,
        "client_name": "Тест",
        "client_email": "test@example.com"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check user paid - not found",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "check_user_paid",
        "client_email": "nonexistent@example.com"
      },
      "expectedStatus": 200,
      "expectedBody": { "paid": false },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check status missing",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "check_status",
        "order_number": "EST-00000"
      },
      "expectedStatus": 404,
      "expectedBody": { "error": "Заказ не найден" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Create invoice - missing company data",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create_invoice",
        "plan_type": "b2b_start",
        "company_name": "",
        "inn": "",
        "client_email": "test@company.ru"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Create invoice - invalid plan_type",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "create_invoice",
        "plan_type": "invalid_plan",
        "company_name": "ООО Тест",
        "inn": "1234567890",
        "client_email": "test@company.ru"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "unknown"
      },
      "expectedStatus": 400,
      "expectedBody": { "error": "string" },
      "bodyMatcher": "partial"
    }
  ]
}
