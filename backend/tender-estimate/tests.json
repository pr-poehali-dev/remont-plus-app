{
  "tests": [
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Пустой запрос без текста и изображений",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Расчёт по тексту ТЗ",
      "method": "POST",
      "path": "/",
      "body": {"text": "Штукатурка стен 40 м2. Стяжка пола 25 м2. Укладка плитки на пол 25 м2. Установка унитаза 1 шт."},
      "expectedStatus": 200,
      "expectedBody": {"subtotal": "number", "items": "array"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Анализ сметы заказчика (маржа)",
      "method": "POST",
      "path": "/",
      "body": {"mode": "analyze", "text": "Смета заказчика: Штукатурка стен 40 м2 по 1200 руб. Стяжка пола 25 м2 по 950 руб. Укладка плитки 25 м2 по 1500 руб."},
      "expectedStatus": 200,
      "expectedBody": {"mode": "analyze", "items": "array", "analysis": "object"},
      "bodyMatcher": "partial"
    }
  ]
}