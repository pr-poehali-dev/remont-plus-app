{
  "tests": [
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Список без идентификации — пусто",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"estimates": "array"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Сохранение сметы по email",
      "method": "POST",
      "path": "/",
      "headers": {"X-User-Email": "test-tender@example.com"},
      "body": {"title": "Тестовая смета", "mode": "estimate", "total": 12345, "payload": {"items": [{"name": "Штукатурка", "qty": 10}]}},
      "expectedStatus": 200,
      "expectedBody": {"saved": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Список смет по email",
      "method": "GET",
      "path": "/",
      "headers": {"X-User-Email": "test-tender@example.com"},
      "expectedStatus": 200,
      "expectedBody": {"estimates": "array"},
      "bodyMatcher": "partial"
    }
  ]
}
