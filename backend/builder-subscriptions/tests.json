{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get active plans",
      "method": "GET",
      "path": "/?action=plans",
      "expectedStatus": 200
    },
    {
      "name": "Get my subscription - no contractor_id",
      "method": "GET",
      "path": "/?action=my",
      "expectedStatus": 400
    },
    {
      "name": "Get my subscription",
      "method": "GET",
      "path": "/?action=my&contractor_id=1",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Check subscription - no contractor_id",
      "method": "GET",
      "path": "/?action=check",
      "expectedStatus": 400
    },
    {
      "name": "Check subscription with budget",
      "method": "GET",
      "path": "/?action=check&contractor_id=1&budget=300000",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Activate - missing fields",
      "method": "POST",
      "path": "/",
      "body": {"action": "activate"},
      "expectedStatus": 400
    }
  ]
}